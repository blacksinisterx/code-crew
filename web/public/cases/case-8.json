  "tool": "rea-agents",
  "version": "6.7.0",
  "command": "rea analyze-javascript-application <ship> --json",
  "rawSha256": "d0cb1d8e971ecbb38bde4e92c7db5ffc8699fd56389f574ad70f6c43c8d6b048"
 },
